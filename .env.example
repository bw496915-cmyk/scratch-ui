# Server Configuration (AI Studio binds port 3000 on 0.0.0.0)
PORT=3000
NODE_ENV=development

# Optional Live Desk / Companion API Origin & Data Feeds
# Explicit server-side daemon URL. Leave empty when no daemon is connected.
# Local development only: http://127.0.0.1:4020
# Hosted deployments need a reachable private service URL, not the operator Mac's loopback.
SPORTSDESK_API_ORIGIN=
# Optional mounted collector receipt file; missing/invalid receipts display unavailable.
SPORTSDESK_BRIDGE_STATE_PATH=
# Optional local JSON file path overriding the live wager feed source.
SPORTSDESK_LIVE_WAGERS_JSON=
# Optional retained SQLite database for read-only Shadow Pricing.
SHADOW_PRICE_DB=

# Dashboard Authentication (fail-closed by default; set tokens before exposing)
SPORTSDESK_DASHBOARD_TOKEN=
SPORTSDESK_OPERATOR_PASSWORD=
# Use a distinct admin token for privileged actions. Browser admins enter it at sign-in.
SPORTSDESK_ADMIN_TOKEN=
# Optional server-owned Bun CSRF signing key. SQLite supplies a stable local key when unset.
CSRF_SECRET=
# Optional temporary Fast Sign-In bookmark token (?fast_signin=<token>, min 16 chars)
SPORTSDESK_FAST_SIGNIN_TOKEN=
SPORTSDESK_FAST_SIGNIN_EXPIRES_AT=
SPORTSDESK_FAST_SIGNIN_TTL_MINUTES=1440
# Keyed HMAC salt for deterministic /24#hash IP redaction in weblogs/profiles
SPORTSDESK_IP_HASH_SALT=
# Local dev/test opt-out ONLY (ignored when NODE_ENV=production or unset): set to 1
SPORTSDESK_AUTH_DISABLED=
SPORTSDESK_ALLOWED_ORIGINS=

# Optional PostgreSQL & Cloudflare R2 Storage
DATABASE_URL=
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SESSION_TOKEN=
R2_ENDPOINT=
R2_BUCKET_NAME=sportsdesk-ops-reports

# Optional Telegram & Cloudflare Worker / MCP Secrets
TELEGRAM_BOT_TOKEN=
# Referenced by config/wager_tiers.toml (env:TELEGRAM_WEBHOOK_URL)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_ALLOWED_CHATS=
DESK_ADMIN_TOKEN=
WORKSPACE_VAULT_KEY=

# Optional Local Runtime & Verification Harness (used by scripts/verify_runtime_connections.ts)
SPORTSDESK_BIND_HOST=0.0.0.0
# Set both paths to serve HTTPS and WebSocket upgrades on the same listener.
SPORTSDESK_TLS_CERT_PATH=
SPORTSDESK_TLS_KEY_PATH=
F402_OFFLINE_ONLY=1
# Private projected manager roster (schemaVersion/agents/players). No fixture fallback.
SPORTSDESK_CUSTOMER_ROSTER_JSON=
# Private aggregate projection made by scripts/project_customer_history.ts; never raw graded exports.
SPORTSDESK_CUSTOMER_HISTORY_JSON=
# Optional private SQLite file for sessions and session-scoped themes that survive restarts.
SPORTSDESK_SESSION_DB_PATH=
# Optional existing private object key for the admin S3 HEAD check.
R2_HEALTHCHECK_KEY=
# Dedicated signed R2 S3 endpoint (separate policy from read-only public fallback)
R2_S3_ENDPOINT=
# Read-only public R2 fallback origin (never receives signed requests or auth headers)
R2_PUBLIC_URL=https://pub-d061f943df0e4477ba7ff200721eddb1.r2.dev
# Local BookDeskOps serve-local origin (default: http://127.0.0.1:8787)
BOOKDESKOPS_SERVE_LOCAL=
# Set to 1 in local dev to allow literal loopback ?apiBase= overrides
ALLOW_LOOPBACK_API_BASE=
# Optional outbound corporate proxy (prefer http:// + CONNECT) with isolated proxy vs target CA paths
HTTPS_PROXY=
PROXY_AUTH=
PROXY_CA=
ORIGIN_CA=
