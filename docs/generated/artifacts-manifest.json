    {
      "command": "bun run cli docs render <file|metaId> [--mode render|ansi|html] [--profile <name>] [--ids]",
      "description": "Render a Markdown file or SD-DOC-* ID via Bun.markdown.render() / Bun.markdown.ansi(AnsiTheme) with GFM tables and #id badges"
    },
    {
      "command": "bun run cli surface [--kinds|--deep|--json]",
      "description": "Run read-only live Bun Runtime Surface audit (Bun.* kinds, bun:* modules, namespaces, classes)"
    },
    {
      "command": "bun run cli version status [--json|--md|--ansi]",
      "description": "Inspect unified SemVer matrix across workspace packages, design tokens/branding, and Bun runtime pin"
    },
    {
      "command": "bun run cli version check [--json]",
      "description": "Fail-closed Bun.semver parity gate verifying workspace, design system, and Bun version alignment"
    },
    {
      "command": "bun run cli version satisfies <version> <range>",
      "description": "Evaluate Bun.semver.satisfies(version, range) with strict ASCII/uint64 guards"
    },
    {
      "command": "bun run cli version order <versionA> <versionB>",
      "description": "Compare two SemVer strings with Bun.semver.order (-1 | 0 | 1)"
    },
    {
      "command": "bun run cli version sort [--desc] <v1> <v2> ...",
      "description": "Sort semantic versions using Bun.semver.order"
    },
    {
      "command": "bun run cli version max <range> <v1> <v2> ...",
      "description": "Select the highest version satisfying a SemVer range via Bun.semver"
    },
    {
      "command": "bun run cli version bump <release|x.y.z> [--preid <tag>] [--dry-run]",
      "description": "Bump all workspace package manifests in lockstep with Bun.semver monotonic validation"
    },
    {
      "command": "bun run cli check [gate|all]",
      "description": "Execute repository integrity gates under Bun (versions, lockfile, registry-parity, route-surface, bundle-hygiene, shell-boundary, snapshots, artifacts, docs)"
    },
    {
      "command": "bun run cli scripts [filter] [--md|--ansi] [--profile <name>]",
      "description": "Inspect grouped package.json scripts using Bun.inspect.table or Bun.markdown.ansi tables"
    }
  ],
  "packageScripts": {
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "format:debug": "bun fmt --debug-check",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "registry:install": "bun install --cwd tools/registry --frozen-lockfile",
    "registry:start": "bun run --cwd tools/registry start",
    "registry:check": "bun scripts/check_local_registry.ts",
    "cli": "bun scripts/sportsdesk_cli.ts",
    "version:status": "bun scripts/sportsdesk_cli.ts version status",
    "version:check": "bun scripts/sportsdesk_cli.ts version check",
    "version:bump": "bun scripts/sportsdesk_cli.ts version bump",
    "gen:tokens": "bun scripts/gen_artifacts.ts --tokens-only",
    "gen:tokens:gate": "bun scripts/gen_artifacts.ts --tokens-only --check",
    "artifacts:generate": "bun scripts/gen_artifacts.ts",
    "artifacts:check": "bun scripts/gen_artifacts.ts --check",
    "branding:generate": "bun scripts/gen_branding_assets.ts",
    "branding:check": "bun scripts/gen_branding_assets.ts --check",
    "docs:check": "bun scripts/sportsdesk_cli.ts docs check",
    "dev": "NODE_ENV=development SPORTSDESK_DEV_SERVER=1 tsx server.ts",
    "start": "node server.mjs",
    "start:local": "bun --no-env-file server.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --external:bun:sqlite --outfile=server.mjs",
    "build:metafile": "NODE_ENV=production bun build ./src/dashboard/index.tsx --outdir ./dist/metafile --production --target=browser --env=PUBLIC_* --metafile=./dist/meta.json --metafile-md=./dist/meta.md",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "clean": "rm -rf dist server.js server.mjs",
    "lint": "tsc --noEmit && tsc --noEmit --project scripts/tsconfig.runtime.json && tsc --noEmit --project packages/ui/tsconfig.json",
    "test": "bun test",
    "test:update-snapshots": "TZ=UTC bun test --update-snapshots",
    "check:lockfile": "bun scripts/check_lockfile_integrity.ts",
    "check:registry-parity": "bun scripts/check_registry_parity.ts",
    "check:route-surface": "bun scripts/check_route_surface.ts",
    "check:bundle-hygiene": "bun scripts/check_bundle_hygiene.ts",
    "check:runtime": "bun scripts/verify_runtime_connections.ts",
    "check:shell-boundary": "bun scripts/check_shell_boundary.ts",
    "check:snapshots": "bun scripts/check_snapshot_hygiene.ts",
    "check:ci": "bun run format:check && bun run format:debug && bun run version:check && bun run check:lockfile && bun run check:registry-parity && bun run artifacts:check && bun run docs:check && bun test && bun run check:snapshots && bun run check:route-surface && bun run check:bundle-hygiene && bun run check:shell-boundary"
  }
}
