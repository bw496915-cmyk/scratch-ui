{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./*"],
      "bun:bundle": ["./src/shims/bun_bundle.ts"],
      "@sportsdesk-ops/contracts": ["./packages/contracts/src/index.ts"],
      "@sportsdesk-ops/contracts/wager-tokens": ["./packages/contracts/src/wager_tokens.ts"],
      "@sportsdesk-ops/contracts/slice-metrics": ["./packages/contracts/src/slice_metrics.ts"],
      "@sportsdesk-ops/contracts/slice-registry": ["./packages/contracts/src/slice_registry.ts"],
      "@sportsdesk-ops/contracts/slice-data-table": [
        "./packages/contracts/src/slice_data_table.ts"
      ],
      "@sportsdesk-ops/contracts/slice-diff-view": ["./packages/contracts/src/slice_diff_view.ts"],
      "@sportsdesk-ops/contracts/shadow-pricing": ["./packages/contracts/src/shadow_pricing.ts"],
      "@sportsdesk-ops/contracts/features": ["./packages/contracts/src/features.ts"],
      "@sportsdesk-ops/contracts/dashboard-hydration": [
        "./packages/contracts/src/dashboard_hydration.ts"
      ],
      "@sportsdesk-ops/backend": ["./packages/backend/src/index.ts"],
      "@sportsdesk-ops/backend/*": ["./packages/backend/src/*.ts"],
      "@sportsdesk-ops/api": ["./packages/api/src/index.ts"],
      "@sportsdesk-ops/api/*": ["./packages/api/src/*.ts"],
      "@sportsdesk-ops/ui": ["./packages/ui/src/index.ts"],
      "@sportsdesk-ops/ui/App": ["./packages/ui/src/App.tsx"],
      "@sportsdesk-ops/ui/ShadowPricingPanel": ["./packages/ui/src/ShadowPricingPanel.tsx"],
      "@sportsdesk-ops/ui/SliceMetricsViews": ["./packages/ui/src/SliceMetricsViews.tsx"],
      "@sportsdesk-ops/ui/ansi": ["./packages/ui/src/ansi.tsx"],
      "@sportsdesk-ops/ui/config": ["./packages/ui/src/config/dashboard.ts"],
      "@sportsdesk-ops/ui/config/dashboard": ["./packages/ui/src/config/dashboard.ts"],
      "@sportsdesk-ops/ui/config/wagers": ["./packages/ui/src/config/wagers.ts"],
      "@sportsdesk-ops/ui/hydration": ["./packages/ui/src/hydration.ts"],
      "@sportsdesk-ops/ui/links": ["./packages/ui/src/links.ts"],
      "@sportsdesk-ops/ui/panels": ["./packages/ui/src/panels/index.tsx"],
      "@sportsdesk-ops/ui/shadow-pricing": ["./packages/ui/src/shadow_pricing/index.tsx"],
      "@sportsdesk-ops/ui/runtime-flags": ["./packages/ui/src/runtime_flags.ts"],
      "@sportsdesk-ops/ui/terminal-catalog": ["./packages/ui/src/terminal_catalog.ts"],
      "@sportsdesk-ops/ui/styles": ["./packages/ui/src/dashboard_styles.ts"],
      "@sportsdesk-ops/ui/types": ["./packages/ui/src/types.ts"],
      "@sportsdesk-ops/ui/styles/tokens.css": ["./packages/ui/src/styles/tokens.css"],
      "@sportsdesk-ops/ui/styles/reset.css": ["./packages/ui/src/styles/reset.css"],
      "@sportsdesk-ops/ui/desk.css": ["./packages/ui/src/desk.css"]
    },
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "dist",
    "node_modules",
    "docs",
    "static",
    "tests",
    "design",
    "schema",
    "scripts/verify_runtime_connections.ts",
    "scripts/verify_browser_session.ts",
    "scripts/project_customer_history.ts",
    "worker-configuration.d.ts",
    "workers"
  ]
}
